# Copy this file to .env and fill in the values below.
#
#   cp .env.example .env

# Airflow container user (keeps mounted files owned by your host user)
AIRFLOW_UID=50000

# Image (latest stable)
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.2

# Encryption key for connections/variables stored in the metadata DB.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# JWT secret used to sign tokens between the API server and task executions (Airflow 3.x).
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__API_AUTH__JWT_SECRET=

# Default admin web UI credentials
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
